{
  "name": "prod-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "start": "node dist-server/server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server scripts prisma tests vite.config.ts prisma.config.ts --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run build",
    "preview": "npm run start",
    "db:generate": "prisma generate",
    "db:setup": "node scripts/local-db.mjs setup",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:seed": "prisma db seed",
    "db:verify": "tsx prisma/verify.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "auth:provision": "tsx scripts/auth-provision.ts",
    "auth:seed": "tsx scripts/auth-seed.ts",
    "auth:prune": "tsx scripts/auth-prune.ts",
    "test": "tsc -p tsconfig.tests.json && node --import tsx --test --test-concurrency=1 tests/auth/*.test.ts",
    "test:setup": "tsx scripts/auth-test-setup.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.13",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
