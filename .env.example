# Neon is the project database for development and deployment.
# Copy pooled + direct URLs from the Neon console. Never expose them with a VITE_ prefix.
#
# Runtime (Prisma client / app) — often the pooler hostname:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
#
# Migrations — direct (non-pooler) hostname:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
#
# Do not set SHADOW_DATABASE_URL for Neon (Prisma uses its own shadow handling).
# If node-pg warns about sslmode, prefer uselibpqcompat=true&sslmode=require
# or sslmode=verify-full. Drop channel_binding=require if your client rejects it.

# Optional application listen settings; defaults: dev 127.0.0.1:5173,
# production 0.0.0.0:3000.
# HOST=127.0.0.1
# PORT=3000

# Auth rate limits use the direct socket IP unless a hosting-specific trusted
# proxy boundary is configured. Leave unset/false for local development.
# Examples after that decision: TRUST_PROXY=1 or TRUST_PROXY=loopback
# TRUST_PROXY=false

# Required for HTTP auth startup and auth commands. Generate a fresh secret from
# at least 32 random bytes, never reuse the placeholder below.
BETTER_AUTH_SECRET="GENERATE_A_PRIVATE_RANDOM_SECRET"
# App origin while you preview on this machine (must stay loopback for auth:seed).
BETTER_AUTH_URL="http://127.0.0.1:5173"
# Compiled production verification on this machine uses http://127.0.0.1:3000.
# Hosted production requires a fixed HTTPS origin, with no path or credentials.

# Explicit fixture password for the five fictional accounts, 6 through 128
# characters with an uppercase letter and a number. Set privately before
# npm run auth:seed. Never use a real staff password here.
# LOCAL_AUTH_TEST_PASSWORD=

# Separate test database (Neon branch or another database name), created by a
# trusted operator first. Must differ from the ordinary development database.
# Tests never reset the ordinary development database.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb_auth_test?sslmode=require&uselibpqcompat=true"
