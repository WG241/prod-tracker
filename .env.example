# npm run db:setup creates local credentials and writes .env on Windows x64.
# Other platforms: create native PostgreSQL databases and fill these values.
# Never expose database URLs with a VITE_ prefix.

# Local app connection (PrismaPg / standard PostgreSQL TCP)
DATABASE_URL="postgresql://prod_tracker:LOCAL_PASSWORD@127.0.0.1:5433/prod_tracker"

# Migration and shadow connections (separate databases, owned by the local role)
DATABASE_URL_UNPOOLED="postgresql://prod_tracker:LOCAL_PASSWORD@127.0.0.1:5433/prod_tracker"
SHADOW_DATABASE_URL="postgresql://prod_tracker:LOCAL_PASSWORD@127.0.0.1:5433/prod_tracker_shadow"

# Neon deployment: runtime may use the pooled hostname, migrations use the direct
# hostname. Keep sslmode=require and certificate validation. Do not set the local
# SHADOW_DATABASE_URL for deployment.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional application listen settings; defaults: dev 127.0.0.1:5173,
# production 0.0.0.0:3000.
# HOST=127.0.0.1
# PORT=3000

# Auth rate limits use the direct socket IP unless a hosting-specific trusted
# proxy boundary is configured. Leave unset/false for local development.
# Examples after that decision: TRUST_PROXY=1 or TRUST_PROXY=loopback
# TRUST_PROXY=false

# Required for HTTP auth startup and auth commands. Generate a fresh secret from
# at least 32 random bytes, never reuse the placeholder below.
BETTER_AUTH_SECRET="GENERATE_A_PRIVATE_RANDOM_SECRET"
BETTER_AUTH_URL="http://127.0.0.1:5173"
# Compiled local production verification uses http://127.0.0.1:3000 instead.
# Remote production requires a fixed HTTPS origin, with no path or credentials.

# Explicit local fixture password, 15 through 128 Unicode characters.
# Set privately before npm run auth:seed. Never use a real staff password here.
# LOCAL_AUTH_TEST_PASSWORD=

# Separate local test database, created by a trusted database operator first.
# Tests never reset the ordinary development database.
# TEST_DATABASE_URL="postgresql://prod_tracker:LOCAL_PASSWORD@127.0.0.1:5433/prod_tracker_auth_test"
